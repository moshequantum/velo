{
  "name": "{{.ProjectSlug}}",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"{{if eq .DataProvider "surrealdb"}},
    "db:local": "surreal start --user root --pass root memory",
    "db:migrate": "surreal import --conn http://127.0.0.1:8000 --user root --pass root --ns test --db test db/schema.surql"{{end}}
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"{{if eq .DataProvider "surrealdb"}},
    "surrealdb": "2.2.2"{{end}}
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
