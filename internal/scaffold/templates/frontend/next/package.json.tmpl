{
  "name": "{{.ProjectSlug}}",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && wrangler dev"{{if eq .DataProvider "surrealdb"}},
    "db:local": "surreal start --user root --pass root memory",
    "db:migrate": "surreal import --conn http://127.0.0.1:8000 --user root --pass root --ns test --db test db/schema.surql"{{end}}
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"{{if eq .DataProvider "surrealdb"}},
    "surrealdb": "2.2.2"{{end}}
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^0.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.0",
    "typescript": "^5.6.0"
  }
}
